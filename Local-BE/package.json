    "@types/ws": "^8.18.1",
    "axios": "^1.19.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "screenshot-desktop": "^1.15.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
