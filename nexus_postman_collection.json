{
  "info": {
    "name": "Nexus v2 Backend Cloud API",
    "description": "Postman Collection for testing Nexus v2 Cloud Backend on Render",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://nexus-v2-e38m.onrender.com",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "sessionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "pairingCode",
      "value": "NX-7824",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        }
      }
    },
    {
      "name": "2. Auth - Signup (New User)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "    var res = pm.response.json();",
              "    var token = res.token || res.data?.token;",
              "    pm.collectionVariables.set('token', token);",
              "    pm.environment.set('token', token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Nexus Developer\",\n  \"email\": \"testuser_01@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/signup",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "signup"]
        }
      }
    },
    {
      "name": "3. Auth - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var res = pm.response.json();",
              "    var token = res.token || res.data?.token;",
              "    pm.collectionVariables.set('token', token);",
              "    pm.environment.set('token', token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"testuser_01@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "4. Device - Pair Companion (nexus.exe)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pairingcode\": \"{{pairingCode}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/pairrequest",
          "host": ["{{baseUrl}}"],
          "path": ["api", "pairrequest"]
        }
      }
    },
    {
      "name": "5. Chat - AI System Info",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var res = pm.response.json();",
              "    pm.collectionVariables.set('sessionId', res.sessionId);",
              "    pm.environment.set('sessionId', res.sessionId);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "x-session-id", "value": "{{sessionId}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"Check my system info and hardware status\",\n  \"behaviour\": \"developer\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/chat/message",
          "host": ["{{baseUrl}}"],
          "path": ["api", "chat", "message"]
        }
      }
    },
    {
      "name": "6. Chat - AI Desktop Search & Launch",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "x-session-id", "value": "{{sessionId}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"Search for Roblox player on my PC and open it\",\n  \"behaviour\": \"friendly\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/chat/message",
          "host": ["{{baseUrl}}"],
          "path": ["api", "chat", "message"]
        }
      }
    },
    {
      "name": "7. Chat - Get Conversation History",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "x-session-id", "value": "{{sessionId}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"limit\": 20\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/chat/history",
          "host": ["{{baseUrl}}"],
          "path": ["api", "chat", "history"]
        }
      }
    },
    {
      "name": "8. Chat - Delete Session",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "x-session-id", "value": "{{sessionId}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/chat/session",
          "host": ["{{baseUrl}}"],
          "path": ["api", "chat", "session"]
        }
      }
    }
  ]
}
